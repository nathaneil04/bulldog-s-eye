PORT=8787
APP_NAME=God's Eye

# Optional: OpenSky client credentials for higher API access limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: TomTom traffic key for global traffic-flow queries.
TOMTOM_API_KEY=

# Optional: Mapillary token for adding a Mapillary camera/street-imagery layer.
MAPILLARY_ACCESS_TOKEN=

CESIUM_ION_TOKEN=

# Optional identity sent to Digitraffic in its recommended request header.
DIGITRAFFIC_USER=GodsEye/1.0 (open-data-map)

# When frontend and API are deployed separately, set the public backend URL here.
VITE_API_BASE_URL=
